SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_YOUR_SERVER_KEY
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PUBLIC_KEY
PORT=3000
# Enable only after firewall/proxy rules restrict the website, API and all origins to campus networks.
# This flag removes student IP limits; it does not enforce network access restrictions.
# CAMPUS_NETWORK_ONLY=true
# Optional Node crypto concurrency (1–8, default 8). Requires restart.
# Workers default to 1; maximum 2, only after memory/capacity validation.
# PASSWORD_HASH_CONCURRENCY=8
# npm start / npm run dev set the Node thread pool to 8 unless overridden.
# UV_THREADPOOL_SIZE=8
